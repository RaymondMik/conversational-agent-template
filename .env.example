# Model in LiteLLM format: <provider>/<model>. Examples:
#   anthropic/claude-sonnet-5-5
#   openai/gpt-4o
#   gemini/gemini-2.5-pro
#   ollama/llama3.1
#   openai/<model>   with LLM_API_BASE for any OpenAI-compatible server
LLM_MODEL=anthropic/claude-sonnet-5-5

# Optional: base URL for OpenAI-compatible or self-hosted endpoints
# LLM_API_BASE=http://localhost:11434

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Prompt profile: file name (without .yaml) inside the prompts/ directory
PROMPT_PROFILE=default

# Provider API keys. LiteLLM reads these directly from the environment.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Gradio server
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
